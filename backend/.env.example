# ============================================================
# SARATHI Backend Environment Configuration (.env)
# ============================================================
DATABASE_URL=sqlite:///./sarathi.db
JWT_SECRET_KEY=sarathi-secure-jwt-secret-key-production-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Permitted Frontend CORS Origins
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Government / Administration Dedicated Authority Account
GOVERNMENT_EMAIL=admin@example.com
GOVERNMENT_PASSWORD=admin123
